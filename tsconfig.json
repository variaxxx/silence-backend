{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2020"],

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "node",

    "strict": true,
    "outDir": "dist/",
    "sourceMap": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules/", "dist/"]
}
